{
  "name": "wasabi-table",
  "version": "1.0.8",
  "description": "High-performance Excel-like table component built with Rust and WebAssembly",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "pkg/wasabi_table.js",
    "pkg/wasabi_table_bg.js",
    "pkg/wasabi_table_bg.d.ts",
    "pkg/wasabi_table.d.ts",
    "pkg/wasabi_table_bg.wasm",
    "pkg/wasabi_table_bg.wasm.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "pkg/wasabi_table.js",
    "pkg/wasabi_table_bg.js",
    "dist/index.js"
  ],
  "scripts": {
    "build": "wasm-pack build --target bundler --out-dir pkg && rm -f pkg/.gitignore && node scripts/patch-wasm-types.mjs && npm run build:ts && npm run fix-imports",
    "build:wasm": "wasm-pack build --target bundler --out-dir pkg && rm -f pkg/.gitignore && node scripts/patch-wasm-types.mjs",
    "build:ts": "tsc",
    "fix-imports": "node scripts/fix-imports.js",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:rust": "wasm-pack test --headless --chrome",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:record": "RECORD_E2E=1 playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test:unit && cargo test && npm run test:rust && npm run test:e2e",
    "strip-debug-logs": "node scripts/strip-debug-logs.mjs",
    "strip-debug-logs:dist": "node scripts/strip-debug-logs.mjs --dist",
    "build:publish": "npm run build && npm run strip-debug-logs:dist",
    "build:site": "vite build --config vite.config.site.ts",
    "clean": "rm -rf dist pkg playwright-report test-results",
    "prepublishOnly": "npm run build:publish",
    "serve": "vite --host 127.0.0.1 --port 8501 --strictPort",
    "serve:static": "python3 -m http.server 8501",
    "serve:node": "npx http-server -p 8501 -c-1"
  },
  "keywords": [
    "table",
    "spreadsheet",
    "excel",
    "webassembly",
    "rust",
    "canvas",
    "high-performance"
  ],
  "author": "masanori0209",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masanori0209/wasabi-table.git"
  },
  "bugs": {
    "url": "https://github.com/masanori0209/wasabi-table/issues"
  },
  "homepage": "https://masanori0209.github.io/wasabi-table/examples/npm-package/index.html",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^20.0.0",
    "happy-dom": "^20.10.2",
    "http-server": "^14.1.1",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
